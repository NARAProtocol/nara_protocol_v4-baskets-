# Local dev secrets for `npm run dev:cf` (wrangler pages dev).
# Copy to .dev.vars and fill in. .dev.vars is gitignored repo-wide.
#
# CoinGecko on-chain (GeckoTerminal) key for /api/pairs.
#   Demo plan  -> https://api.coingecko.com/api/v3/onchain     (header x-cg-demo-api-key)
#   Pro plan   -> https://pro-api.coingecko.com/api/v3/onchain (header x-cg-pro-api-key)
# Without a key, functions fall back to the public GeckoTerminal API (rate-limited).
CG_API_KEY=CG-your-key-here
CG_API_PLAN=demo

# Optional Coinbase onramp. Keep disabled unless the server-side origin allowlist
# and Cloudflare WAF rate limit are configured.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
ONRAMP_ALLOWED_ORIGINS=http://127.0.0.1:4175

# Optional local adapter overrides. Production should set every adapter deployed
# and registered in each basket manager.
# VITE_BASKET_ADAPTER_AERO=0x...
# VITE_BASKET_ADAPTER_SLIPSTREAM=0x...
# VITE_BASKET_ADAPTER_PANCAKE=0x...
