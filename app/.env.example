# Vite env for NARA Baskets. Copy to `.env` (gitignored) for local dev.
# Production sets these in the Cloudflare Pages dashboard.

# RainbowKit / WalletConnect project ID. Public client identifier (ships in the
# bundle, not a secret). Shared across NARA apps. Get your own: https://cloud.reown.com
VITE_RAINBOW_PROJECT_ID=your_project_id

# Deployed contract addresses (Base mainnet). Empty = "Launching" badges in UI.
VITE_USE_FORK=false
VITE_BASKET_MANAGER_BASE=
VITE_BASKET_MANAGER_AI=
# CULTURE basket in UI.
VITE_BASKET_MANAGER_MEME=
# FINANCE basket in UI.
VITE_BASKET_MANAGER_DEFI=

# Required production launch decision. Leave blank for preview; set live only
# after manifest parity and on-chain verification. Use exit_only to disable buys.
VITE_BASKET_STATUS_BASE=
VITE_BASKET_STATUS_AI=
VITE_BASKET_STATUS_MEME=
VITE_BASKET_STATUS_DEFI=

# Swap adapters. Set every adapter that was deployed and registered in each basket manager.
# UniswapV3BasketAdapterV1.
VITE_BASKET_ADAPTER=
# AerodromeBasketAdapterV1.
VITE_BASKET_ADAPTER_AERO=
# AerodromeSlipstreamBasketAdapterV1.
VITE_BASKET_ADAPTER_SLIPSTREAM=
# PancakeV3BasketAdapterV1.
VITE_BASKET_ADAPTER_PANCAKE=
# UniswapV4BasketAdapterV1 for the NARA hooked pool.
VITE_BASKET_ADAPTER_V4=

# NARA Uniswap v4 pool config. Leave empty until the v4 hook pool is deployed and verified.
VITE_NARA_V4_HOOK=
VITE_NARA_V4_POOL_FEE=
VITE_NARA_V4_TICK_SPACING=
VITE_UNISWAP_V4_QUOTER=0x0d5e0F971ED27FBff6c2837bf31316121532048D

# NARA v4 token + fee collector (filled after mainnet deploy).
VITE_NARA_TOKEN=
VITE_NARA_FEE_COLLECTOR=
